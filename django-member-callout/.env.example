SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# PostgreSQL connection
DB_NAME=crewlink
DB_USER=crewlink
DB_PASSWORD=crewlink
DB_HOST=db
DB_PORT=5432

# Redis (used for caching / future Celery)
REDIS_URL=redis://redis:6379/0

# AI Drafting configuration
# AI_PROVIDER: 'fake' (default, no API key needed) or 'gemini'
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=8
AI_TOTAL_BUDGET_SECONDS=10
AI_BREAKER_FAILURES=5
AI_BREAKER_WINDOW_SECONDS=60
AI_BREAKER_COOLDOWN_SECONDS=60
AI_THROTTLE=10/min

# CORS configuration
CORS_ALLOWED_ORIGIN_REGEXES=^http://(localhost|127\.0\.0\.1)(:\d+)?$
